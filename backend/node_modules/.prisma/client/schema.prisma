model User {
  id        String   @id @default(cuid())
  email     String?  @unique
  phone     String?  @unique
  password  String
  role      Role     @default(TRADER)
  createdAt DateTime @default(now())

  trader Trader?
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Booking {
  id             String        @id @default(uuid())
  customerId     String
  customer       Customer      @relation(fields: [customerId], references: [id])
  traderId       String
  trader         Trader        @relation(fields: [traderId], references: [id])
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id])
  slotStart      DateTime
  slotEnd        DateTime
  bufferMinutes  Int
  bookingFee     Float
  status         BookingStatus @default(PENDING)
  createdAt      DateTime      @default(now())
  payment        Payment?

  @@index([traderId, slotStart, slotEnd])
}

model Business {
  id                String   @id @default(uuid())
  name              String
  stripeConnectedId String?
  createdAt         DateTime @default(now())
  trader            Trader[]
}

model Customer {
  id            String         @id @default(uuid())
  name          String?
  phone         String         @unique
  createdAt     DateTime       @default(now())
  conversations Conversation[]
  bookings      Booking[]
}

model Conversation {
  id         String             @id @default(uuid())
  customerId String
  customer   Customer           @relation(fields: [customerId], references: [id])
  traderId   String
  trader     Trader             @relation(fields: [traderId], references: [id])
  channel    Channel
  status     ConversationStatus @default(OPEN)
  createdAt  DateTime           @default(now())
  messages   Message[]
  bookings   Booking[]
}

enum ConversationStatus {
  OPEN
  BOOKED
  CLOSED
}

enum Channel {
  WHATSAPP
  WEB_CHAT
}

enum Sender {
  CUSTOMER
  TRADER
  SYSTEM
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  REQUIRES_PAYMENT
  SUCCEEDED
  FAILED
  REFUNDED
}

enum Role {
  TRADER
  CUSTOMER
  ADMIN
}

enum SlotStatus {
  AVAILABLE
  BOOKED
  CANCELLED
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  sender         Sender
  channel        Channel
  content        String
  sentAt         DateTime     @default(now())
}

model Payment {
  id                    String        @id @default(uuid())
  bookingId             String        @unique
  booking               Booking       @relation(fields: [bookingId], references: [id])
  stripePaymentIntentId String        @unique
  amount                Float
  applicationFeeAmount  Float
  status                PaymentStatus @default(REQUIRES_PAYMENT)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
}

model Trader {
  id         String    @id @default(uuid())
  userId     String    @unique
  user       User      @relation(fields: [userId], references: [id])
  businessId String?
  business   Business? @relation(fields: [businessId], references: [id])
  name       String
  phone      String

  createdAt     DateTime       @default(now())
  workAreas     WorkArea[]
  converSations Conversation[]
  bookings      Booking[]

  @@index([businessId])
}

model WhatsappLog {
  id        String   @id @default(uuid())
  phone     String
  message   String
  status    String
  createdAt DateTime @default(now())
}

model WorkArea {
  id            String   @id @default(uuid())
  traderId      String
  trader        Trader   @relation(fields: [traderId], references: [id])
  availableDate DateTime
  area          String
  createdAt     DateTime @default(now())

  @@unique([traderId, availableDate])
}
